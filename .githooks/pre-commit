#!/usr/bin/env bash
# Regenerate tracked excel/testdata workbooks and stage any changes before commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

"$ROOT/scripts/regenerate-excel-testdata.sh"

# Stage updated workbooks (no-op if bytes unchanged).
if git diff --name-only -- 'excel/testdata' | grep -q '\.xlsx$'; then
  git diff --name-only -- 'excel/testdata' | grep '\.xlsx$' | xargs -r git add --
fi
